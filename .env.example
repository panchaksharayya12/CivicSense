# =======================================================
# CivicSense Environment Configuration
# =======================================================

# Port & Node Environment
PORT=3000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=civicsense-production-secret-key-smart-city-2026

# Google Gemini AI Integration (Separate for Civic Chat & Complaint Analyzer)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_ai_api_key_here

# Supabase PostgreSQL Database (Optional - local persistent engine runs out of the box)
DATABASE_URL=postgresql://postgres:password@localhost:5432/civicsense
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Maps & Geolocation API (Optional - Leaflet & OpenStreetMap included out of the box)
MAP_API_KEY=your_map_api_key_here
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap
